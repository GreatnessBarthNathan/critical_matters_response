{
  "name": "critical-matters-response",
  "version": "1.0.0",
  "private": true,
  "description": "A confidential church leadership and pastoral response platform.",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently -n API,WEB -c green,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node server.js",
    "check": "npm --prefix frontend run lint && npm --prefix frontend run build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "smoke": "node test/smoke.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "otplib": "12.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "10.2.0",
    "nodemon": "^3.1.10",
    "supertest": "7.1.4"
  }
}
