{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "noCheck": true,
    "types": ["node"]
  },
  "include": ["server.ts", "app.ts", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
