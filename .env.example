NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/critical-matters-response?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CSRF_SECRET=replace-with-a-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
RECOVERY_CODE_PEPPER=replace-with-a-dedicated-random-secret-at-least-32-characters
# Keep the previous value here temporarily when rotating RECOVERY_CODE_PEPPER, then remove it after all old codes expire.
RECOVERY_CODE_PREVIOUS_PEPPERS=
INVITATION_TTL_DAYS=7
ASSISTED_RESET_TTL_MINUTES=15
CLIENT_URL=http://localhost:5173
# Keep at 0 unless the app is deployed behind a known reverse proxy. Use 1 for one trusted proxy hop.
TRUST_PROXY_HOPS=0

# Browser push notifications are optional. Generate these once with `npm run generate:vapid-keys`.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A pastor account is created or promoted on startup when both values are set.
ADMIN_EMAIL=pastor@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
ADMIN_FIRST_NAME=Lead
ADMIN_LAST_NAME=Pastor

# Optional: creates or assigns a restricted technical-support account on startup. This role can
# manage invitations, user access, reset codes, and non-report audit activity, but cannot access reports.
TECH_SUPPORT_EMAIL=support@example.com
TECH_SUPPORT_PASSWORD=replace-with-a-strong-initial-password
TECH_SUPPORT_FIRST_NAME=Tech
TECH_SUPPORT_LAST_NAME=Support
